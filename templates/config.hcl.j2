ui            = true
cluster_addr  = "https://192.168.1.97:8201"
api_addr      = "https://192.168.1.97:8200"

storage "raft" {
  path = "/var/lib/openbao/data"
  node_id = "LocalHostProut"
}

listener "tcp" {
  address       = "0.0.0.0:8200"
  tls_cert_file = "/etc/openbao/tls/openbao.crt"
  tls_key_file  = "/etc/openbao/tls/openbao.key"
}

# attention à ca, c'est bien que si Tu as un agent de log (Promtail/Loki, Vector, Filebeat, Datadog Agent) installé sur la machine.
#attention si le disque est plein, ca peut foutre le bordel
audit "file" "local-file" {
  description = "Journalisation des requêtes dans un fichier local"
  options {
    file_path = "/var/log/openbao/audit.log"
  }
}